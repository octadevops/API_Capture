# CSE API Capture - Environment Variables
# Copy this file to .env and fill in your keys. NEVER commit .env (already in .gitignore)
# See .streamlit/secrets.toml.example for Streamlit Cloud equivalent

# --- Firecrawl (https://www.firecrawl.dev) ---
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alias accepted by app:
# FIRECRAWL_API_TOKEN=fc-xxx

# --- Apify (https://apify.com) ---
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Trained Model ---
# Local fine-tuned checkpoint or HF id. Priority: TRAINED_MODEL_PATH > CSE_MODEL_PATH > models/cse_finbert > ProsusAI/finbert
TRAINED_MODEL_PATH=models/cse_finbert
# CSE_MODEL_PATH=models/cse_finbert

# --- CSE Engine Order (comma-separated, overrides default Firecrawl→Apify→Crawl4AI→Selenium→Requests) ---
CSE_ENGINE_ORDER=firecrawl,apify,crawl4ai,selenium,requests

# --- Hugging Face (optional, for private models) ---
# HF_TOKEN=hf_xxx

# --- General ---
# FLASK_PORT=5000
# STREAMLIT_PORT=8501
